// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Prisma Postgres datasource (db.prisma.io).
// DATABASE_URL  → postgres:// connection string (runtime queries)
// DIRECT_URL    → same postgres:// URL (prisma migrate — Prisma Postgres has built-in pooling)
// Set both vars in Vercel's Environment Variables dashboard.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id            String   @id @default(uuid())
  shop          String   @unique
  name          String?
  category      String?
  themeStyle    String?
  brandColors   String?
  logoUrl       String?
  isOnboarded   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id            String   @id @default(uuid())
  shop          String   @unique
  plan          String
  status        String
  chargeId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Template {
  id            String   @id
  name          String
  category      String
  tier          String
  thumbnail     String
  sections      String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Customization {
  id            String   @id @default(uuid())
  shop          String
  templateId    String
  sections      String
  colors        String
  fonts         String
  logo          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, templateId])
}

model MediaAsset {
  id            String   @id @default(uuid())
  shop          String
  url           String
  fileName      String
  createdAt     DateTime @default(now())
}
