// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Session model — used by @shopify/shopify-app-session-storage-prisma.
// The package stores/looks-up sessions by the `id` field which holds the
// Shopify session-ID string.  We map it directly to MongoDB's `_id`.
model Session {
  id                  String    @id @map("_id")
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              String?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  shop          String   @unique
  name          String?
  category      String?
  themeStyle    String?
  brandColors   String?
  logoUrl       String?
  isOnboarded   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  shop          String   @unique
  plan          String
  status        String
  chargeId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Template {
  id            String   @id @map("_id")
  name          String
  category      String
  tier          String
  thumbnail     String
  sections      String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Customization {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  shop          String
  templateId    String
  sections      String
  colors        String
  fonts         String
  logo          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, templateId])
}

model MediaAsset {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  shop          String
  url           String
  fileName      String
  createdAt     DateTime @default(now())
}
